# ==============================================================================
# FlowDesk Environment Variables Example
# Copy this file to .env.local and configure your actual values.
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL - Neon / Supabase / Local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowdesk?schema=public"

# Authentication (Auth.js / NextAuth v5)
# Generate a secret: `openssl rand -base64 32`
AUTH_SECRET="your-super-secret-auth-key-change-in-production"
AUTH_URL="http://localhost:3000"

# OAuth Providers (Optional for local testing)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cache & Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="example_token"

# Object Storage (Cloudflare R2 / AWS S3 for PDFs)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="flowdesk-invoices"
R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"

# Email Delivery (Resend)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="FlowDesk Invoicing <billing@yourdomain.com>"
